# ============================================================
# TorrenClou — optional overrides
# ============================================================
# You do not need this file.
#
# The container generates its own secrets on first run and keeps them on the
# data volume. Everything else — your account, cloud storage, transfer settings
# — is configured in the browser the first time you open the app.
#
# Use this only for the cases the defaults cannot cover: an external database,
# a reverse proxy that rewrites the host, or a shipping-logs setup.
#
# To use it:  docker run --env-file .env ...
# ============================================================

# --- Behind a reverse proxy ---------------------------------
# Only if your proxy does not forward X-Forwarded-Host. Without these the app
# works out its own address from the request.
# PUBLIC_FRONTEND_URL=https://torrents.example.com
# NEXTAUTH_URL=https://torrents.example.com

# --- External PostgreSQL ------------------------------------
# POSTGRES_DB=torrenclo
# POSTGRES_USER=torrenclo_user
# POSTGRES_PASSWORD=

# --- Pinned secrets -----------------------------------------
# Set these to keep sessions valid across a rebuilt data volume.
# JWT_SECRET=
# NEXTAUTH_SECRET=

# --- Shipping logs and traces off-box -----------------------
# OBSERVABILITY_LOKI_URL=
# OBSERVABILITY_LOKI_USERNAME=
# OBSERVABILITY_LOKI_API_KEY=
# OBSERVABILITY_OTLP_ENDPOINT=
# OBSERVABILITY_OTLP_HEADERS=

# --- Grafana ------------------------------------------------
# A password is generated on first run. Read it with:
#   docker exec torrencloud cat /data/secrets.env
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=
